# Required — regenerate from Upstox developer portal → your app → Generate access token
# Expired tokens cause HTTP 401 on search/LTP and WebSocket disconnect loops.
UPSTOX_ACCESS_TOKEN=

# Optional until OAuth token refresh is implemented
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_alerts
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production
PORT=4000

NODE_ENV=development

# Get these from https://developers.facebook.com/ → your app → WhatsApp → API Setup
# For production, use a System User permanent token (not the 24h test token).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your phone in E.164 format without + (e.g. 919876543210 for India) — dev fallback only
WHATSAPP_RECIPIENT_PHONE=

# Frontend URL for CORS (must match where Next.js runs)
FRONTEND_URL=http://localhost:3000
